 

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  DROPPED
}

enum GradeLetter {
  A
  B
  C
  D
  E
  F
}

// ---------------------------------------------------------------------------
// Auth / identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  role         Role
  isActive     Boolean  @default(true)
  refreshToken String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student    Student?
  instructor Instructor?
  admin      Admin?

  @@map("users")
}

model Admin {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  faculty   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students    Student[]
  instructors Instructor[]
  courses     Course[]

  @@map("departments")
}

model Semester {
  id                 String   @id @default(cuid())
  name               String
  session             String
  registrationStart  DateTime
  registrationEnd    DateTime
  isActive           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  courses       Course[]
  registrations Registration[]

  @@unique([name, session])
  @@map("semesters")
}

model Instructor {
  id           String   @id @default(cuid())
  userId       String   @unique
  instructorNo String   @unique
  name         String
  email        String   @unique
  office       String?
  phone        String?
  departmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])
  courses    Course[]

  @@map("instructors")
}

model Student {
  id           String    @id @default(cuid())
  userId       String    @unique
  studentNo    String    @unique
  fullName     String
  email        String    @unique
  phone        String?
  departmentId String
  faculty      String
  level        Int
  gender       Gender?
  dob          DateTime?
  address      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    Department     @relation(fields: [departmentId], references: [id])
  registrations Registration[]

  @@map("students")
}

// ---------------------------------------------------------------------------
// Courses
// ---------------------------------------------------------------------------

model Course {
  id                 String   @id @default(cuid())
  code               String
  title              String
  description        String?  @db.Text
  credits            Int
  instructorId       String?
  semesterId         String
  departmentId       String
  scheduleDay        String? // e.g. "MON,WED"
  scheduleStart      String? // "09:00"
  scheduleEnd        String? // "10:30"
  venue              String?
  maxStudents        Int
  currentEnrollment  Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  instructor Instructor? @relation(fields: [instructorId], references: [id])
  semester   Semester    @relation(fields: [semesterId], references: [id])
  department Department  @relation(fields: [departmentId], references: [id])

  registrations Registration[]

  // Self-referencing many-to-many for prerequisites
  prerequisiteFor Course[] @relation("CoursePrerequisites")
  prerequisites   Course[] @relation("CoursePrerequisites")

  @@unique([code, semesterId])
  @@map("courses")
}

model Registration {
  id           String             @id @default(cuid())
  studentId    String
  courseId     String
  semesterId   String
  status       RegistrationStatus @default(PENDING)
  registeredAt DateTime           @default(now())
  droppedAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  student  Student  @relation(fields: [studentId], references: [id])
  course   Course   @relation(fields: [courseId], references: [id])
  semester Semester @relation(fields: [semesterId], references: [id])
  grade    Grade?

  @@unique([studentId, courseId])
  @@map("registrations")
}

model Grade {
  id             String      @id @default(cuid())
  registrationId String      @unique
  letter         GradeLetter
  gradePoint     Float
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("grades")
}
